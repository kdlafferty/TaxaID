^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$
^DISCLAIMER\.md$
^CLAUDE\.md$
^\.lintr$
^\.Rhistory$
^\.DS_Store$
^taxaid_workflow.*\.R$
^taxaid_methods.*\.md$
^(?!inst/fast_workflows/).*\.rds$
^.*\.csv$
^workflow_context\.json$
^REENTRY_PROMPT\.md$
^.*\.bak_.*$
# The per-package review correspondence: the reviewer comments and our
# responses. They stay in the repository as the record of the review, but
# they are development history rather than documentation and were shipping
# inside the installed package -- 763 KB across the nine, delivered to every
# user. Excluded from the build so the record survives without shipping.
# NOTE: .Rbuildignore has no comment syntax; every line here is a regex, so
# these lines must stay free of regex-special characters.
^inst/.*_review\.Rmd$
^inst/.*_review_response\.md$
# Two development scripts in fast_workflows/. The four run_*_smoketest.R
# scripts and their fixtures are user material and still ship; these two are
# not. build_fast_fixture.R is the fixture builder, driven by hand against
# checkpoints the developer supplies, and run_review_fixes_fast_check.R is a
# scoped before/after check written against a specific set of changes and a
# real occurrence checkpoint that is not in the repository. They stay in the
# repository as part of the development record and do not ship.
^inst/fast_workflows/build_fast_fixture\.R$
^inst/fast_workflows/run_review_fixes_fast_check\.R$
