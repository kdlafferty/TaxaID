linters: linters_with_defaults(
    line_length_linter(120L),
    # Disabled package-wide, not per-file: near-100% false positives here.
    # - indentation_linter: a hanging-indent house style choice.
    # - commented_code_linter: mathematical formula comments (e.g.
    #   "v = w*Var_ceiling + (1-w)*Var_floor + ...") that parse as valid R
    #   arithmetic once the leading "#" is stripped, plus this ecosystem's
    #   "# function_name()" section-header convention -- not dead code.
    # - object_name_linter / object_length_linter: this package's kernel/
    #   GLMM math code uses standard statistical notation (K, K2, W_mat,
    #   S2_mat, N_total mirroring exported field names) and several
    #   exported/internal functions have long, deliberately descriptive
    #   names -- not worth a rename for a snake_case/30-char style limit.
    indentation_linter = NULL,
    commented_code_linter = NULL,
    object_name_linter = NULL,
    object_length_linter = NULL
  )
encoding: "UTF-8"
exclusions: list(
    # gap_indistinct/gap_complex-style NSE column references inside
    # dplyr::mutate()/case_when() blocks that lint_package()'s per-file
    # static analysis can't always trace, and a genuinely-unused local test
    # fixture kept for documentation purposes -- both already-vetted false
    # positives, not dead code.
    "tests/testthat/test-generate_full_priors.R" = list(object_usage_linter = c(56L)),
    "tests/testthat/test-train_biodiversity_model_by_group.R" = list(object_usage_linter = c(20L)),
    # Line-length: pure formatting (long sprintf/warning/message diagnostic
    # strings, dense statistical-notation expressions) spread thinly across
    # many files in this package's kernel-priors/GLMM machinery -- zero
    # security- or correctness-relevant value; the real findings here (a
    # genuinely-incomplete f1/f2 diagnostic message, an if/else brace-style
    # fix, a seq_len() edge-case guard) were fixed directly instead of
    # suppressed.
    "R/plot_theta_surface.R" = list(line_length_linter = Inf),
    "R/apply_undetected_evidence.R" = list(line_length_linter = Inf),
    "R/estimate_kernel_priors.R" = list(line_length_linter = Inf),
    "R/kernel_budget_sensitivity.R" = list(line_length_linter = Inf),
    "R/plot_theta_map_interactive.R" = list(line_length_linter = Inf),
    "R/generate_invasive_watch_evidence.R" = list(line_length_linter = Inf),
    "R/generate_full_priors.R" = list(line_length_linter = Inf),
    "R/compute_moran_basis.R" = list(line_length_linter = Inf),
    "R/calibrate_kernel_bandwidth.R" = list(line_length_linter = Inf),
    "R/prepare_model_dataframe.R" = list(line_length_linter = Inf),
    "R/generate_undetected_diversity.R" = list(line_length_linter = Inf),
    "R/generate_regional_proximity_evidence.R" = list(line_length_linter = Inf),
    "R/generate_inat_range_evidence.R" = list(line_length_linter = Inf),
    "R/generate_domestic_food_priors.R" = list(line_length_linter = Inf),
    "R/fit_regional_presence_curve.R" = list(line_length_linter = Inf),
    "R/add_pca_covariates.R" = list(line_length_linter = Inf),
    "tests/testthat/test-apply_undetected_evidence.R" = list(line_length_linter = Inf),
    "tests/testthat/test-generate_regional_proximity_evidence.R" = list(line_length_linter = Inf),
    "tests/testthat/test-generate_domestic_food_priors.R" = list(line_length_linter = Inf),
    "inst/workflows/generate_priors_workflow.R" = list(line_length_linter = Inf)
  )
