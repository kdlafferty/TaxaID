lon_seq  <- seq(-119.5, -118.0, by = 0.5)
grid_ids <- as.vector(outer(lat_seq, lon_seq, function(la, lo) {
  s <- sprintf("Grid_\%.1f_\%.1f", la, lo)
  s <- gsub("-", "m", s, fixed = TRUE)
  gsub(".", "p", s, fixed = TRUE)
}))
basis <- compute_moran_basis(grid_ids, k = 5L)
