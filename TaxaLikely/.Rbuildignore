^inst/extra_functions_review_inputs\.R$
# The per-package review correspondence: the reviewer comments and our
# responses. They stay in the repository as the record of the review, but
# they are development history rather than documentation and were shipping
# inside the installed package -- 763 KB across the nine, delivered to every
# user. Excluded from the build so the record survives without shipping.
# NOTE: .Rbuildignore has no comment syntax; every line here is a regex, so
# these lines must stay free of regex-special characters.
^inst/.*_review\.Rmd$
^inst/.*_review_response\.md$
# A standalone figure script for presentations and manuscripts, not part of
# the package's own documentation. Development record; does not ship.
^inst/plot_likelihood_landscape\.R$
