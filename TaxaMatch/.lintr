linters: linters_with_defaults(
    line_length_linter(120L),
    indentation_linter = NULL,
    # This package's internal helpers/constants use long, deliberately
    # descriptive names (e.g. .compute_hierarchy_congruence,
    # .ACCESSION_REVIEW_RELEVANT_COLS) and SCREAMING_SNAKE_CASE module
    # constants (.EVAL_REF_ACC_VERSION, .MIFISH_STYLE_TO_MARKER, etc.) --
    # an established, deliberate convention throughout this package, not a
    # style violation. Neither linter earns its keep here.
    object_name_linter = NULL,
    object_length_linter = NULL
  )
encoding: "UTF-8"
exclusions: list(
    # JSON literals inside @examples blocks that commented_code_linter's
    # heuristic misidentifies as commented-out R code.
    "R/read_image_classifiers.R" = list(commented_code_linter = Inf, line_length_linter = c(956L, 957L)),
    # "# function_name()" section-header comments and file-path/prose
    # comments that happen to parse as valid R (division chains, etc.) --
    # this ecosystem's established false-positive class, not dead code.
    "R/build_site_table.R" = list(commented_code_linter = Inf),
    "R/local_corroboration.R" = list(commented_code_linter = Inf),
    "R/blast_sequences.R" = list(commented_code_linter = Inf),
    # object_usage_linter false positives: these files call internal helpers
    # defined in utils_shared.R (.check_pkg, .extract_genus,
    # .stop_missing_files, .validate_min_conf_top_n, .apply_top_n,
    # .warn_na_coercion, .warn_duplicate_basenames, .fmt_time).
    # lint_package()'s per-file static analysis does not resolve cross-file
    # calls within a package namespace; confirmed real and correct via
    # codetools::checkUsage() on the loaded package.
    "R/read_birdnet_output.R" = list(object_usage_linter = Inf),
    "R/score_image_inat.R" = list(object_usage_linter = Inf),
    "R/sequence_input.R" = list(object_usage_linter = Inf),
    "R/standardize_match_data.R" = list(object_usage_linter = Inf),
    # Remaining line-length hits in real R/ source files: pure formatting
    # (long sprintf/warning strings, long function calls) with no security-
    # or correctness-relevant value -- fixing every one carries no benefit
    # at this stage; the real findings in this package (2 genuinely dead
    # local variables, a broken .lintr config, naming/pipe-consistency
    # fixes) were fixed directly instead of suppressed.
    "R/evaluate_reference_accessions.R" = list(
      commented_code_linter = Inf,
      line_length_linter = Inf
    ),
    "R/group_observations_by_bbox.R" = list(line_length_linter = c(306L)),
    "R/investigate_flagged_accession.R" = list(line_length_linter = c(742L, 1065L)),
    "R/join_event_site_metadata.R" = list(line_length_linter = c(108L)),
    "R/migrate_reference_cache.R" = list(line_length_linter = c(88L, 143L)),
    "R/reference_label_verdict.R" = list(
      commented_code_linter = Inf,
      line_length_linter = Inf
    ),
    "R/review_flagged_accessions.R" = list(
      commented_code_linter = Inf,
      line_length_linter = c(108L, 768L)
    ),
    "R/trim_query_to_amplicon.R" = list(line_length_linter = Inf),
    # search_calls <<- / call_log[[...]] <<- are closures mutating their own
    # enclosing test's call-counter/logger -- the standard, documented use
    # of <<- (a closure updating enclosing-scope state), not the "reaching
    # into an unrelated/global environment" pattern this linter targets.
    "tests/testthat/test-investigate-flagged-accession.R" = list(
      assignment_linter = c(467L),
      object_usage_linter = c(369L),
      commented_code_linter = Inf,
      line_length_linter = Inf
    ),
    "tests/testthat/test-review-flagged-accessions.R" = list(assignment_linter = c(349L), line_length_linter = Inf),
    # local_mocked_bindings() is testthat's own exported function, always
    # available inside a test_that() block -- lint_package()'s per-file
    # static analysis doesn't know testthat itself is implicitly attached
    # in test files.
    "tests/testthat/test-evaluate-reference-accessions.R" = list(
      object_usage_linter = c(381L, 384L, 387L),
      line_length_linter = Inf,
      commented_code_linter = Inf
    ),
    # Remaining files below: pure line-length/commented-code noise in
    # workflow/demo scripts (not shipped, non-tested) and test-assertion
    # strings -- same reasoning as above.
    "inst/workflow_fastq_to_match.R" = list(commented_code_linter = Inf),
    "inst/workflow_standardize.R" = list(commented_code_linter = Inf),
    "inst/workflow_image_acoustic.R" = list(commented_code_linter = Inf),
    "inst/workflows/score_image_workflow.R" = list(commented_code_linter = Inf, line_length_linter = Inf),
    "inst/workflows/blast_sequences_workflow.R" = list(commented_code_linter = Inf),
    "inst/workflows/score_acoustic_workflow.R" = list(commented_code_linter = Inf, line_length_linter = Inf),
    "inst/extra_functions_review_inputs.R" = list(commented_code_linter = Inf, line_length_linter = Inf),
    "vignettes/match-standardization.Rmd" = list(commented_code_linter = Inf),
    "tests/testthat/test-local-corroboration.R" = list(commented_code_linter = Inf, line_length_linter = Inf),
    "tests/testthat/test-trim-query-to-amplicon.R" = list(commented_code_linter = Inf, line_length_linter = Inf),
    "tests/testthat/test-taxonomy_consistency.R" = list(commented_code_linter = Inf),
    "tests/testthat/test-sequence_input.R" = list(commented_code_linter = Inf),
    "tests/testthat/test-read_image.R" = list(commented_code_linter = Inf),
    "tests/testthat/test-group_observations_by_bbox.R" = list(commented_code_linter = Inf),
    "tests/testthat/test-check-marker-mismatch.R" = list(commented_code_linter = Inf),
    "tests/testthat/test-blast.R" = list(commented_code_linter = Inf, line_length_linter = Inf),
    "tests/testthat/test-read_speciesnet.R" = list(line_length_linter = Inf),
    "tests/testthat/test-convert_taxonomy_backbone.R" = list(line_length_linter = Inf),
    "tests/testthat/test-build_site_table.R" = list(line_length_linter = Inf)
  )
