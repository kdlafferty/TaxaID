linters: linters_with_defaults(
    line_length_linter(120L),
    indentation_linter = NULL
  )
exclusions: list(
    # JSON literals inside @examples blocks that lintr's commented_code_linter
    # misidentifies as commented-out R code (closing "]}'," / "}}',\" lines).
    "R/read_image_classifiers.R" = list(commented_code_linter = c(535L, 712L)),
    # object_usage_linter false positives: these files call internal helpers
    # defined in utils_shared.R (.check_pkg, .extract_genus,
    # .stop_missing_files, .validate_min_conf_top_n, .apply_top_n,
    # .warn_na_coercion, .warn_duplicate_basenames, .fmt_time).
    # lint_package()'s per-file static analysis does not resolve cross-file
    # calls within a package namespace; confirmed real and correct via
    # codetools::checkUsage() on the loaded package (same false-positive
    # class already documented for TaxaFetch's get_gbif_occurrences.R).
    "R/blast_sequences.R" = list(object_usage_linter = Inf),
    "R/read_birdnet_output.R" = list(object_usage_linter = Inf),
    "R/read_image_classifiers.R" = list(object_usage_linter = Inf),
    "R/score_image_inat.R" = list(object_usage_linter = Inf),
    "R/sequence_input.R" = list(object_usage_linter = Inf),
    "R/standardize_match_data.R" = list(object_usage_linter = Inf)
  )
encoding: "UTF-8"
