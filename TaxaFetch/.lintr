linters: linters_with_defaults(
  line_length_linter(120L),
  indentation_linter = NULL
  )
encoding: "UTF-8"
exclusions: list(
    # dataone_preview.R:410's `<<-` mutates its enclosing function's own
    # `bytes_rx` accumulator inside a download callback -- the standard,
    # documented use of `<<-` (a closure updating enclosing-scope state),
    # not the "reaching into an unrelated/global environment" pattern this
    # linter exists to catch (same pattern as TaxaLikely's .save_record()).
    # The commented_code_linter hits are this file's own top-of-file
    # "workflow mirror" example comments, already vetted false positives.
    "R/dataone_preview.R" = list(
      commented_code_linter = c(42L, 43L, 44L, 45L, 46L, 47L, 48L, 50L, 51L, 52L, 53L, 56L, 59L, 60L, 61L, 63L, 66L, 68L),
      assignment_linter = c(410L)
    ),
    # Every "# function_name()" line below is a section-header comment
    # (this ecosystem's established convention) parsing as a bare call by
    # coincidence, not dead code.
    "R/dataone_catalog.R" = list(commented_code_linter = c(14L)),
    "R/dataone_eml_screen.R" = list(commented_code_linter = c(19L)),
    "R/dataone_geo_screening.R" = list(commented_code_linter = c(15L, 16L, 19L, 24L, 26L, 32L, 299L)),
    "R/dataone_taxon_screening.R" = list(commented_code_linter = c(14L, 15L, 18L, 19L, 20L, 22L, 23L, 26L, 31L, 33L, 34L, 40L, 325L)),
    # A top-of-file "workflow mirror" example-usage comment (search_dataone(bbox)).
    "R/dataone_standardize.R" = list(commented_code_linter = c(28L)),
    # "# ID / citation" is a plain English label that happens to parse as a
    # division expression once the leading "#" is stripped -- not dead code.
    "R/download_gbif_occurrences.R" = list(commented_code_linter = c(290L)),
    "R/get_gbif_occurrences.R" = list(commented_code_linter = c(419L)),
    "R/literature_search.R" = list(commented_code_linter = c(120L, 516L)),
    "R/pdf_api.R" = list(commented_code_linter = c(40L, 156L)),
    "R/pdf_characterize.R" = list(commented_code_linter = c(90L, 165L, 210L, 337L, 453L, 522L, 619L, 702L)),
    "R/pdf_extract.R" = list(commented_code_linter = c(344L, 375L, 659L)),
    "R/pdf_text.R" = list(commented_code_linter = c(110L, 194L, 279L, 384L)),
    # Reviewer-facing runnable-example / workflow scripts, not shipped
    # package code -- commented_code_linter misfires on deliberate
    # "alternative approach, uncomment if needed" documentation blocks and
    # "# function_name() -> function_name()" pipeline-diagram comments
    # (this ecosystem's established scratch-script documentation style,
    # already vetted for the same pattern in TaxaTools).
    "inst/biotime_workflow.R" = list(commented_code_linter = Inf),
    "inst/dataone_quickstart.R" = list(commented_code_linter = Inf),
    "inst/Dataone_workflow.R" = list(commented_code_linter = Inf),
    "inst/extra_functions_review_inputs.R" = list(commented_code_linter = Inf),
    "inst/Merge_sources_workflow.R" = list(commented_code_linter = Inf),
    "inst/pdf_workflow_test_v4.R" = list(commented_code_linter = Inf),
    "inst/review_function_inputs.R" = list(
      commented_code_linter = Inf,
      # RUN_GBIF_ACCOUNT_DOWNLOAD/RUN_OPENALEX_LITERATURE/RUN_LLM_CALLS are
      # SCREAMING_SNAKE_CASE user-configurable constants -- this ecosystem's
      # established convention for top-level config in scripts, not a
      # naming bug.
      object_name_linter = c(62L, 63L, 64L)
    ),
    "inst/llm_provider_examples.R" = list(
      commented_code_linter = Inf,
      # call_gemini_api()/call_openai_api()/call_ollama_api() are loaded via
      # library(TaxaTools) at the top of this script -- a real, correct
      # call lintr's per-file static analysis can't resolve outside package
      # NAMESPACE scope (confirmed via codetools::checkUsage() equivalent
      # reasoning already established for cross-file package calls).
      object_usage_linter = Inf
    ),
    "inst/workflows/fetch_occurrences_workflow.R" = list(
      commented_code_linter = Inf,
      # DEBUG_MODE/GBIF_SMALL_QUERY_THRESHOLD/STUDY_TAXA/STUDY_LAT/STUDY_LON/
      # STUDY_RADIUS/YEAR_RANGE/GBIF_LIMIT/OUT_DIR/OUT_PREFIX -- the same
      # established SCREAMING_SNAKE_CASE config-constant convention.
      object_name_linter = c(42L, 48L, 52L, 53L, 54L, 55L, 56L, 57L, 88L, 89L)
    ),
    # taxonKey (camelCase) is a mock function argument deliberately matching
    # rgbif's own real API parameter name, not a style violation.
    "tests/testthat/test-check_geographic_outliers.R" = list(object_name_linter = c(76L)),
    "tests/testthat/test-fetch_gbif_occurrences.R" = list(
      object_name_linter = c(127L, 140L, 170L, 240L, 340L, 370L)
    ),
    # Inline "what this mock stands in for" comments (e.g.
    # "# iconic_taxon_name = \"Aves\"") that parse as valid R assignments.
    "tests/testthat/test-check_inat_range.R" = list(commented_code_linter = c(448L)),
    "tests/testthat/test-fetch_inat_occurrences.R" = list(commented_code_linter = c(84L)),
    # "# .bbox_overlaps()" section-header comment, same established pattern.
    "tests/testthat/test-dataone_occurrence_search.R" = list(commented_code_linter = c(130L))
  )
